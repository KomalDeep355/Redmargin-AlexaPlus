# Copy this file to .env and fill in what you use. Keep .env private and ignored by Git.

# --- LLM -------------------------------------------------------------
# Supported values:
#   mock          -> no model request; uses deterministic/rule-based fallbacks (default, safe for tests)
#   openai_compat -> an OpenAI-compatible endpoint such as Ollama, Groq, Together, or vLLM
# For openai_compat, set LLM_BASE_URL, LLM_MODEL, and LLM_API_KEY for the same provider.
LLM_PROVIDER=mock

# Local Ollama example (open-weight, runs on your laptop):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Hosted open-weight model on Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=your_groq_key

# Valid range: greater than 0 and at most 300 seconds. Default: 90.
LLM_TIMEOUT_SECONDS=90

# --- GitHub ----------------------------------------------------------
# Optional. Without a token GitHub allows ~60 API calls/hour per IP; a token raises that to 5000.
# Never put a real token here in a committed file or share it publicly.
GITHUB_TOKEN=

# --- Limits ----------------------------------------------------------
# Positive integers only; invalid or out-of-range values are logged and use defaults.
# Configured ranges (default shown):
#   MAX_SOURCE_FILES: 1-50 (12)
MAX_SOURCE_FILES=12
#   MAX_CHARS_PER_FILE: 1-100000 (6000)
MAX_CHARS_PER_FILE=6000
#   MAX_PASTED_POSTINGS_CHARS: 1-500000 (50000), combined request/posting text limit
MAX_PASTED_POSTINGS_CHARS=50000
#   MAX_POSTINGS: 1-200 (50)
MAX_POSTINGS=50
#   MAX_REPO_URL_CHARS: 1-4096 (2048)
MAX_REPO_URL_CHARS=2048
#   MAX_REPO_TREE_PATHS: 1-100000 (10000)
MAX_REPO_TREE_PATHS=10000
#   MAX_REPO_API_RESPONSE_BYTES: 1-100000000 (20000000)
MAX_REPO_API_RESPONSE_BYTES=20000000
#   MAX_REPO_FILES_TO_FETCH: 1-64 (24)
MAX_REPO_FILES_TO_FETCH=24
#   MAX_GITHUB_CONCURRENT_REQUESTS: 1-20 (5)
MAX_GITHUB_CONCURRENT_REQUESTS=5
#   MAX_PROMPT_REPO_CHARS: 1-100000 (10000)
MAX_PROMPT_REPO_CHARS=10000
